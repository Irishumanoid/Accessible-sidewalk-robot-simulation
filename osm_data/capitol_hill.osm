 <node id="13204174202" visible="true" version="3" changeset="173175137" timestamp="2025-10-12T11:22:47Z" user="mueschel" uid="616774" lat="47.6169838" lon="-122.3083793">
  <tag k="addr:city" v="Seattle"/>
  <tag k="addr:country" v="US"/>
  <tag k="addr:housenumber" v="1714"/>
  <tag k="addr:postcode" v="98122"/>
  <tag k="addr:state" v="WA"/>
  <tag k="addr:street" v="18th Avenue"/>
  <tag k="amenity" v="restaurant"/>
  <tag k="branch" v="Polish Home Association"/>
  <tag k="chef" v="Kamila Kanczugowski"/>
  <tag k="contact:email" v="kamilagotuje@gmail.com"/>
  <tag k="contact:facebook" v="sebisbistro"/>
  <tag k="contact:instagram" v="sebiskitchendp"/>
  <tag k="craft" v="caterer"/>
  <tag k="cuisine" v="polish"/>
  <tag k="description" v="A Polish restaurant located in Seattle's Polish Community Center (Dom Polski), offering traditional Polish and European comfort food such as pierogi, kielbasa, and schnitzel. Provides dine-in, takeout, and catering services."/>
  <tag k="description:en" v="A Polish restaurant located in Seattle's Polish Community Center (Dom Polski), offering traditional Polish and European comfort food such as pierogi, kielbasa, and schnitzel. Provides dine-in, takeout, and catering services."/>
  <tag k="description:es" v="Un restaurante polaco ubicado en el Centro Comunitario Polaco de Seattle (Dom Polski), que ofrece comida tradicional polaca y europea como pierogi, kielbasa, y schnitzel. Proporciona servicios para comer en el lugar, para llevar y catering."/>
  <tag k="description:fr" v="Restaurant polonais au Centre Communautaire Polonais de Seattle (Dom Polski), proposant une cuisine polonaise et européenne, comme les pierogis, la kielbasa et le schnitzel. Offre restauration sur place, à emporter et traiteur."/>
  <tag k="description:ja" v="シアトルのポーランドコミュニティセンター（Dom Polski）にあるポーランド料理店で、ピエロギ、キエルバサ、シュニッツェルなど伝統的なポーランドおよびヨーロッパの家庭料理を提供しています。店内飲食、持ち帰り、ケータリングサービスがあります。"/>
  <tag k="description:ko" v="시애틀의 폴란드 커뮤니티 센터 (Dom Polski)에 위치한 폴란드 레스토랑으로, 피에로기, 킬바사, 슈니첼 등 전통적인 폴란드 및 유럽식 편안한 음식을 제공합니다. 식사, 테이크아웃, 케이터링 서비스를 제공합니다."/>
  <tag k="description:pl" v="Polska restauracja znajdująca się w Polskim Centrum Społeczności w Seattle (Dom Polski), oferująca tradycyjne polskie i europejskie dania domowe, takie jak pierogi, kiełbasa i sznycel. Oferuje usługi w sali jadalnej, na wynos i catering."/>
  <tag k="description:ru" v="Польский ресторан, расположенный в Польском культурном центре Сиэтла (Dom Polski), предлагающий традиционные польские и европейские блюда, такие как пироги, колбаса и шницель. Предоставляет услуги по приему пищи на месте, еде навынос и кейтерингу."/>
